def init(module):
    module.name = ":math:proportional_unsigned"
    module.description = FileReader("proportional_unsigned.md")

def prepare(module, options):
    module.depends(
        ":utils",
        ":architecture:assert"
    )
    return True

def build(env):
    env.outbasepath = "modm/src/modm/math"
    env.copy("proportional_unsigned.hpp")
