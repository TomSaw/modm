def init(module):
    module.name = ":graphic"
    module.description = FileReader("graphic.md")

def prepare(module, options):
    module.depends(
        ":graphic:color",
        ":graphic:buffer",
        ":graphic:image",
        ":graphic:font")
    return True

def build(env):
    env.outbasepath = "modm/src/modm/graphic"
    env.copy("graphic.hpp")
    env.copy("display.hpp")
