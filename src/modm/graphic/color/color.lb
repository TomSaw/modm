def init(module):
    module.name = ":graphic:color"
    module.description = """
# Color

Color containers and converters in various formats: Gray, Rgb, Hsh, RgbPallete (f.e. Rgb565)
"""


def prepare(module, options):
    module.depends(
		":math:utils",
		":math:proportional_unsigned",
		":math:saturation"
	)
    return True


def build(env):
    env.outbasepath = "modm/src/modm/graphic/color"
    env.copy(".")
    env.copy("../color.hpp")
