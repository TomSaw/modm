def init(module):
    module.name = ":graphic:painter.fast"
    module.description = """
# Painter

Manipulate Buffers in internal RAM.
Draw Lines, Circles, Rectangles, Text etc.

The size (width and height) of a graphics primitive always correspond
to its mathematical model, ignoring the rendered width. As everything
is drawn one pixel wide, the pixels will be rendered to the right and
below the mathematically defined points.
"""


def prepare(module, options):
    module.depends(
        ":io",
		":graphic:buffer",
	)
    return True


def build(env):
    env.outbasepath = "modm/src/modm/graphic/painter"
    env.copy(".")
    env.copy("../painter.hpp")
